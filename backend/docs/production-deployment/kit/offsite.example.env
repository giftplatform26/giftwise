# Root-owned mode 0600. These are destination settings, not application secrets.
# No spaces or shell metacharacters in host, user or destination directory.
AGE_RECIPIENT=REPLACE_WITH_OWNER_AGE_PUBLIC_RECIPIENT
OFFSITE_USER=REPLACE_WITH_BACKUP_SSH_USER
OFFSITE_HOST=REPLACE_WITH_BACKUP_HOSTNAME
OFFSITE_DIR=/srv/backups/giftwise
OFFSITE_SSH_IDENTITY_FILE=/root/.ssh/giftwise_backup
