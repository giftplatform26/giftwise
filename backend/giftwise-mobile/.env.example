# Public, compiled into the native app. Must be reachable from the device.
# iOS simulator: http://localhost:3100
# Android emulator: http://10.0.2.2:3100
# Physical device: http://YOUR-LAN-IP:3100 (development only)
# Release: use your deployed HTTPS GiftWise web origin.
EXPO_PUBLIC_GIFTWISE_WEB_URL=
# Native browser payment redirects allowed to remain inside the web session.
# Comma-separated HTTPS origins only; configure from your actual provider integration.
EXPO_PUBLIC_GIFTWISE_CHECKOUT_ORIGINS=
# Release identity; choose identifiers under your organization's control.
GIFTWISE_IOS_BUNDLE_ID=
GIFTWISE_ANDROID_PACKAGE=
GIFTWISE_EAS_PROJECT_ID=
